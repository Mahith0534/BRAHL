# OPTIONAL — only if you turn on suite plans that need these accounts.
# Copy lines you need into FoXYiZ/f/.env (do not commit secrets).
#
# These are NOT required for BRAHL AI or demo suites Math / API_Petstore /
# UI_internet / BRAHL_Local / AI_foxyiz.

# Gmail (xMail plans — App Password, not your normal password)
# https://myaccount.google.com/apppasswords
# GMAIL_EMAIL="you@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-app-password"

# LinkedIn Developer App (OAuth token plans — usually Run=N)
# https://www.linkedin.com/developers/apps
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""

# Google OAuth for hosted Arena login (cloud product — not desktop BRAHL default)
# Redirect must match your BRAHL listen URL if you enable it.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# APP_BASE_URL="http://127.0.0.1:8766"
