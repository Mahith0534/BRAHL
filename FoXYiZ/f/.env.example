# Copy this file to  FoXYiZ/f/.env  (same folder) and fill values.
# Never commit .env — secrets stay on your machine.
#
# What this file is FOR
# ---------------------
# Optional BRAHL desktop AI: Build / Analyze / Heal chat helpers.
# It does NOT power FoXYiZ Run / Loop / Verify (those always use FoXYiZ.exe only).
#
# What this file is NOT
# ---------------------
# Not a catalog of every app (Gmail, LinkedIn, Salesforce, …).
# Suite-specific logins belong in that suite's y3 / payloads, or in
# .env.integrations.example if you enable those plans.
#
# Pick ONE AI backend below, then restart BRAHL (Run BRAHL.bat).

# =============================================================================
# A) Cloud OpenAI (BYOK — you pay your own usage)
# =============================================================================
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL=   # leave unset for api.openai.com

# =============================================================================
# B) Local Ollama (free — no cloud key; install https://ollama.com )
#    Example:  ollama pull llama3.2
#    For richer BRAHL Plans (JSON), a larger instruct model helps, e.g.:
#      ollama pull llama3.1:8b
#    Then uncomment and use a dummy key (SDK requires a non-empty value):
# =============================================================================
# OPENAI_API_KEY="ollama"
# OPENAI_BASE_URL="http://127.0.0.1:11434/v1"
# OPENAI_MODEL="llama3.2"

# Any OpenAI-compatible local server works the same way (LM Studio, etc.):
# OPENAI_API_KEY="local"
# OPENAI_BASE_URL="http://127.0.0.1:1234/v1"
# OPENAI_MODEL="your-model-id"
